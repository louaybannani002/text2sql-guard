# Copy to backend/.env and fill in real values. Never commit .env.
# Variables marked REQUIRED have no default and the app refuses to start without them.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Local services (docker-compose.yml, `make up`) ---
# Keep these in sync with DATABASE_URL / REDIS_URL below.
POSTGRES_USER=text2sql
POSTGRES_PASSWORD=change-me
POSTGRES_DB=text2sql
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Database (REQUIRED, secret) ---
# Admin connection: migrations and data loading only.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first (~2s per connect).
DATABASE_URL=postgresql+asyncpg://text2sql:change-me@127.0.0.1:5432/text2sql
# Optional, relative to backend/:
# MIGRATIONS_DIR=db/migrations
# RAW_DATA_DIR=data/raw
# Least-privilege login roles (migration 0004). `make migrate` sets their passwords from these.
READER_DATABASE_URL=postgresql+asyncpg://t2s_reader:change-me@127.0.0.1:5432/text2sql
APP_DATABASE_URL=postgresql+asyncpg://t2s_app:change-me@127.0.0.1:5432/text2sql
# Set by docker-compose.yml for the api container only (do not set here):
# DATABASE_HOST=postgres:5432   REDIS_HOST=redis:6379   replace the host in the URLs.

# --- Cache (REQUIRED, secret) ---
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# Exact cache (SQL + rows) and semantic cache (similar question -> SQL, re-executed).
# CACHE_ENABLED=true
# CACHE_TTL_S=3600
# CACHE_SEMANTIC_TTL_S=86400
# CACHE_SEMANTIC_THRESHOLD=0.95
# CACHE_SEMANTIC_MAX_ENTRIES=1000

# --- LLM (secret) ---
# One key per provider; only the providers of the configured models need one (checked at
# startup). Free tiers work: Gemini for chat + embeddings, Groq as the rate-limit fallback.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# LiteLLM model per role ("provider/model"). Change models here, not in code.
LLM_MODEL_MAIN=gemini/gemini-3.8-flash
LLM_MODEL_FAST=gemini/gemini-3.5-flash-lite
LLM_MODEL_LOCAL=ollama_chat/qwen2.5-coder:7b
# Used automatically when the role's model answers HTTP 429 (rate limit / free-tier quota).
LLM_FALLBACK_MAIN=groq/openai/gpt-oss-120b
LLM_FALLBACK_FAST=groq/openai/gpt-oss-20b
# Must produce 1536-dim vectors (app.schema_docs / app.examples); requested via
# LLM_EMBEDDING_DIMENSIONS. Changing the model re-embeds everything on `make catalog`.
LLM_EMBEDDING_MODEL=gemini/gemini-embedding-001
# LLM_EMBEDDING_DIMENSIONS=1536
LLM_LOCAL_API_BASE=http://127.0.0.1:11434
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Calls to these providers are reported as costing 0 in traces and metrics (free-tier keys).
LLM_FREE_TIER_PROVIDERS=["gemini","groq"]

# --- Retrieval ---
# Max tokens of schema context per prompt.
RETRIEVAL_TOKEN_BUDGET=2500

# --- Executor (runs validated SQL as t2s_reader) ---
EXECUTOR_STATEMENT_TIMEOUT_MS=5000
# EXPLAIN thresholds: top-node cost, and the largest row estimate of any plan node.
EXECUTOR_MAX_COST=1000000
EXECUTOR_MAX_PLAN_ROWS=10000000
EXECUTOR_MAX_ROWS=1000
EXECUTOR_POOL_SIZE=5

# --- Observability ---
# Langfuse tracing is a no-op unless LANGFUSE_ENABLED=true AND all three values are set.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# false: send only the question's length, not its text, as the trace input.
LANGFUSE_CAPTURE_QUESTION=true
# Prometheus GET /metrics (unauthenticated; keep the API on a private network).
METRICS_ENABLED=true

# --- API (REQUIRED secrets) ---
# HS256 key for access tokens: at least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32+-chars
JWT_ACCESS_TTL_S=900
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me-too
RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
# JSON list of exact origins allowed by CORS (the frontend: ["http://localhost:3000"]). Empty = none.
CORS_ALLOWED_ORIGINS=[]
MAX_REQUEST_BYTES=16384
