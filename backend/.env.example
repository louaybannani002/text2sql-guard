# Copy to backend/.env and fill in real values. Never commit .env.
# Variables marked REQUIRED have no default and the app refuses to start without them.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Local services (docker-compose.yml, `make up`) ---
# Keep these in sync with DATABASE_URL / REDIS_URL below.
POSTGRES_USER=text2sql
POSTGRES_PASSWORD=change-me
POSTGRES_DB=text2sql
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Database (REQUIRED, secret) ---
# Admin connection: migrations and data loading only.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first (~2s per connect).
DATABASE_URL=postgresql+asyncpg://text2sql:change-me@127.0.0.1:5432/text2sql
# Optional, relative to backend/:
# MIGRATIONS_DIR=db/migrations
# RAW_DATA_DIR=data/raw
# Least-privilege login roles (migration 0004). `make migrate` sets their passwords from these.
READER_DATABASE_URL=postgresql+asyncpg://t2s_reader:change-me@127.0.0.1:5432/text2sql
APP_DATABASE_URL=postgresql+asyncpg://t2s_app:change-me@127.0.0.1:5432/text2sql

# --- Cache (REQUIRED, secret) ---
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- LLM (REQUIRED, secret) ---
OPENAI_API_KEY=
# LiteLLM model per role ("provider/model"). Change models here, not in code.
LLM_MODEL_MAIN=openai/gpt-5.4
LLM_MODEL_FAST=openai/gpt-5.4-mini
LLM_MODEL_LOCAL=ollama_chat/qwen2.5-coder:7b
# Must produce 1536-dim vectors (app.schema_docs / app.examples columns).
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_LOCAL_API_BASE=http://127.0.0.1:11434
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# --- Retrieval ---
# Max tokens of schema context per prompt.
RETRIEVAL_TOKEN_BUDGET=2500

# --- Executor (runs validated SQL as t2s_reader) ---
EXECUTOR_STATEMENT_TIMEOUT_MS=5000
# EXPLAIN thresholds: top-node cost, and the largest row estimate of any plan node.
EXECUTOR_MAX_COST=1000000
EXECUTOR_MAX_PLAN_ROWS=10000000
EXECUTOR_MAX_ROWS=1000
EXECUTOR_POOL_SIZE=5

# --- Observability: Langfuse (REQUIRED) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
