# Copy to backend/.env and fill in real values. Never commit .env.
# Variables marked REQUIRED have no default and the app refuses to start without them.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Database (REQUIRED, secret) ---
DATABASE_URL=postgresql+asyncpg://text2sql:change-me@localhost:5432/text2sql

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (REQUIRED, secret) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Observability: Langfuse (REQUIRED) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
